{
  "name": "geological-kingdom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Geological Kingdom \u2014 gemstone e-commerce (client + server)",
  "scripts": {
    "setup": "npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client",
    "seed": "npm run seed --prefix server",
    "start": "npm start --prefix server"
  },
  "engines": {
    "node": ">=22"
  }
}
