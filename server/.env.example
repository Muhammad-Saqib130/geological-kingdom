# --- Server ---
PORT=5000
NODE_ENV=development
# Allowed browser origins for CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# MongoDB Atlas: Database > Connect > Drivers. Add your IP under Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/geological-kingdom?retryWrites=true&w=majority

# --- Auth ---
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts
SESSION_TTL_DAYS=7
# lax: client and API on the same site (recommended). none: different sites (HTTPS only)
COOKIE_SAMESITE=lax
# Failed sign-in attempts allowed per email + IP every 15 minutes
LOGIN_RATE_LIMIT=10

# --- Image uploads (Cloudinary: Settings > API Keys) ---
# Leave all three empty in development to store uploads in server/uploads/ instead.
# Required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level Cloudinary folder for this store's assets
CLOUDINARY_FOLDER=geological-kingdom

# --- Seed (npm run seed) ---
# Creates this admin account if it does not exist. Password: at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin

# --- Currency ---
# Fallback PKR per 1 USD, used only until an admin sets a rate in the database
DEFAULT_PKR_PER_USD=280
