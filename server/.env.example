# --- Server ---
PORT=5000
NODE_ENV=development
# Allowed browser origins for CORS, comma-separated.
# On Render it defaults to the service URL, so it can be left unset there.
CLIENT_ORIGIN=http://localhost:5173
# Serve the built client (client/dist) from this server. Defaults to true in production.
# SERVE_CLIENT=false

# --- Database ---
# MongoDB Atlas: Database > Connect > Drivers. Add your IP under Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/geological-kingdom?retryWrites=true&w=majority

# --- Auth ---
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts
SESSION_TTL_DAYS=7
# lax: client and API on the same site (recommended). none: different sites (HTTPS only)
COOKIE_SAMESITE=lax
# Failed sign-in attempts allowed per email + IP every 15 minutes
LOGIN_RATE_LIMIT=10
# All sign-in and sign-up requests allowed per IP every 15 minutes
AUTH_IP_RATE_LIMIT=100
# New accounts allowed per IP per hour
REGISTER_RATE_LIMIT=20

# --- Image uploads (Cloudinary: Settings > API Keys) ---
# Leave all three empty in development to store uploads in server/uploads/ instead.
# Required in production, unless ALLOW_LOCAL_UPLOADS=true below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level Cloudinary folder for this store's assets
CLOUDINARY_FOLDER=geological-kingdom
# Production preview without Cloudinary: store uploads on the server's disk.
# Most hosts (Render free plan included) wipe that disk on every restart, so never use it for real orders.
ALLOW_LOCAL_UPLOADS=false

# --- Storefront URL (used in emails and payment redirects) ---
# Defaults to the first CLIENT_ORIGIN
CLIENT_URL=http://localhost:5173

# --- Card payments (Stripe Checkout, charged in USD) ---
# Leave empty to hide the card option. Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:5000/api/webhooks/stripe` or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=

# --- Email (order confirmations) ---
# Without SMTP_HOST, emails are saved as .eml files in server/mail-outbox/ instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Geological Kingdom <orders@your-domain.com>

# New orders allowed per IP per hour
ORDER_RATE_LIMIT=20

# --- Seed (npm run seed) ---
# Creates this admin account if it does not exist. Password: at least 12 characters.
# Also used on startup when SEED_ON_START=true.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin
# On startup, add the sample catalog if the database is empty and create the admin above
SEED_ON_START=false

# --- Currency ---
# Fallback PKR per 1 USD, used only until an admin sets a rate in the database
DEFAULT_PKR_PER_USD=280
