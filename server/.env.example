# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/geological-kingdom

# Auth (used once auth is implemented)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Fallback PKR per 1 USD, used only until an admin sets a rate in the database
DEFAULT_PKR_PER_USD=280
