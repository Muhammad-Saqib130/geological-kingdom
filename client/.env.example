# Only variables prefixed with VITE_ are exposed to the browser. Never put secrets here.

# Base URL of the API. Leave empty: in development Vite proxies /api, and on Vercel
# client/vercel.json forwards /api to the server (same address, so sign-in cookies work).
VITE_API_URL=
# Public address of the shop, for link previews in index.html. Not needed on Vercel (detected).
VITE_SITE_URL=
# Google Search Console HTML-tag verification code (optional)
VITE_GOOGLE_SITE_VERIFICATION=
# Fallback WhatsApp number (international format without "+") until one is saved in Admin > Settings
VITE_WHATSAPP_NUMBER=923000000000

# Optional contact details shown in the header and footer
VITE_CONTACT_EMAIL=
# Optional social profile URLs; only the ones set are shown in the footer
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TIKTOK_URL=
VITE_YOUTUBE_URL=

# Dev only (not exposed to the browser): where Vite forwards /api requests
API_PROXY_TARGET=http://localhost:5000
