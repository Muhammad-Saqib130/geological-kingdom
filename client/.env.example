# Only variables prefixed with VITE_ are exposed to the browser. Never put secrets here.

# Base URL of the API in production builds. Leave empty in development (Vite proxies /api).
VITE_API_URL=
# Fallback WhatsApp number (international format without "+") until one is saved in Admin > Settings
VITE_WHATSAPP_NUMBER=923000000000

# Optional contact details shown in the header and footer
VITE_CONTACT_EMAIL=
# Optional social profile URLs; only the ones set are shown in the footer
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TIKTOK_URL=
VITE_YOUTUBE_URL=

# Dev only (not exposed to the browser): where Vite forwards /api requests
API_PROXY_TARGET=http://localhost:5000
